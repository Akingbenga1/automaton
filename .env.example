# Apify API Token (get from https://apify.com)
APIFY_API_TOKEN=your_apify_token_here

# Anthropic Claude API Key (get from https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email Configuration (for sending results via SMTP)
# Set EMAIL_ENABLED=true to enable email notifications
EMAIL_ENABLED=true

# SMTP Server Configuration (Mailtrap example)
# For Mailtrap: https://mailtrap.io/
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=25
SMTP_USERNAME=a88f0d12689ce1
SMTP_PASSWORD=0c9b305e67b0ac
SMTP_USE_TLS=true

# Email addresses
EMAIL_FROM=noreply@job-automation.local
EMAIL_TO=your-email@example.com
