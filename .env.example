# ===========================
# API KEYS (REQUIRED)
# ===========================

# Anthropic Claude API Key
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Apify API Token
# Get FREE token at: https://apify.com/
# Free tier includes: $5 credit/month
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxx

# ===========================
# APPLICATION SETTINGS
# ===========================

MAX_APPLICATIONS_PER_HOUR=5
DRY_RUN=true
MANUAL_APPROVAL=true

# Use Claude AI for intelligent job filtering
USE_CLAUDE_FILTERING=true

# Claude model to use
CLAUDE_MODEL=claude-sonnet-4-20250514

# ===========================
# DATABASE
# ===========================

DATABASE_PATH=data/applications.db

# ===========================
# LOGGING
# ===========================

LOG_LEVEL=INFO
LOG_PATH=data/logs/app.log
